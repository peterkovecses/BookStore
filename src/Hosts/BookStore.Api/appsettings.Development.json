{
  "DataProtection": {
    "ApplicationName": "BookStore.Api.Development",
    "KeyRingPath": ".data-protection-keys"
  },
  "EmailDispatcher": {
    "Smtp": {
      "FromAddress": "noreply@bookstore.test"
    }
  },
  "Identity": {
    "Verification": {
      "LinkBaseUrl": "https://localhost:7128/verify-email",
      "TokenLifetime": "1.00:00:00"
    },
    "PasswordRecovery": {
      "LinkBaseUrl": "https://localhost:7001/reset-password",
      "TokenLifetime": "01:00:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
