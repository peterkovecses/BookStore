@inherits LayoutComponentBase

<div class="page">
    <main>
        <div class="top-row px-4 navbar navbar-expand-lg navbar-light bg-light shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center text-primary me-4" href="">
                    <i class="bi bi-book-fill me-2 fs-4"></i>
                    <span class="fw-bold fs-4">BookStore</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <div class="navbar-nav me-auto mb-2 mb-lg-0">
                        <NavLink class="nav-link px-3 fw-medium" href="books">
                            Books
                        </NavLink>
                    </div>

                    <div class="flex-grow-1 d-flex justify-content-center mx-4">
                        <div style="max-width: 500px; width: 100%;">
                            <SearchBox 
                                Placeholder="Search for books, authors or tags..." 
                                OnSearch="HandleGlobalSearch" />
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center auth-placeholders">
                        <AuthorizeView>
                            <Authorized>
                                <button class="btn btn-link text-decoration-none text-dark" @onclick="LogoutAsync" disabled="@_loggingOut">Logout</button>
                            </Authorized>
                            <NotAuthorized>
                                <NavLink class="btn btn-link text-decoration-none text-dark me-2" href="login">Login</NavLink>
                                <NavLink class="btn btn-primary rounded-pill px-4" href="register">Register</NavLink>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                </div>
            </div>
        </div>

        <article class="content px-4 py-4">
            <div class="container">
                <NotificationContainer />
                @if (_logoutError is not null)
                {
                    <div class="alert alert-danger" role="alert">
                        @_logoutError
                        <button class="btn btn-link" @onclick="LogoutAsync" disabled="@_loggingOut">Retry logout</button>
                    </div>
                }
                @Body
            </div>
        </article>
    </main>
</div>

@code {
    [Inject]
    public NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    internal AuthenticationSession Session { get; set; } = default!;

    private bool _loggingOut;
    private string? _logoutError;

    protected override async Task OnInitializedAsync() => await Session.RestoreAsync();

    private async Task LogoutAsync()
    {
        _loggingOut = true;
        _logoutError = null;
        try
        {
            if (!await Session.LogoutAsync())
            {
                _logoutError = "Could not sign out on the server. Please try again.";
            }
        }
        finally
        {
            _loggingOut = false;
        }
    }

    private void HandleGlobalSearch(string searchTerm)
    {
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            NavigationManager.NavigateTo($"/books?searchTerm={Uri.EscapeDataString(searchTerm)}");
        }
    }
}
