@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 navbar navbar-light bg-light shadow-sm sticky-top">
            <div class="container-fluid d-flex align-items-center">
                <div class="flex-grow-1 d-flex justify-content-center mx-4">
                    <div style="max-width: 600px; width: 100%;">
                        <BookStore.UI.Features.Shared.Components.SearchBox 
                            Placeholder="Search for books, authors or tags..." 
                            OnSearch="HandleGlobalSearch" />
                    </div>
                </div>
                
                <div class="d-flex align-items-center auth-placeholders">
                    <button class="btn btn-link text-decoration-none text-dark me-2">Login</button>
                    <button class="btn btn-primary rounded-pill px-4">Register</button>
                </div>
            </div>
        </div>

        <article class="content px-4 py-4">
            <BookStore.UI.Features.Shared.Components.NotificationContainer />
            @Body
        </article>
    </main>
</div>

@code {
    [Inject]
    public NavigationManager NavigationManager { get; set; } = default!;

    private void HandleGlobalSearch(string searchTerm)
    {
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            NavigationManager.NavigateTo($"/books?searchTerm={Uri.EscapeDataString(searchTerm)}");
        }
    }
}
