@page "/login"
@inject AuthenticationSession Session
@inject NavigationManager Navigation

<PageTitle>Login - BookStore</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 fw-bold mb-4">Login</h1>
                @if (_error is not null)
                {
                    <div class="alert alert-danger" role="alert">@_error</div>
                }
                <EditForm Model="_model" OnValidSubmit="LoginAsync">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <InputText id="email" type="email" class="form-control" autocomplete="email" @bind-Value="_model.Email" />
                        <ValidationMessage For="@(() => _model.Email)" />
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label">Password</label>
                        <InputText id="password" type="password" class="form-control" autocomplete="current-password" @bind-Value="_model.Password" />
                        <ValidationMessage For="@(() => _model.Password)" />
                    </div>
                    <button class="btn btn-primary rounded-pill px-4" type="submit" disabled="@_loading">Login</button>
                </EditForm>
                <p class="mt-3 mb-0"><a href="forgot-password">Forgot your password?</a></p>
                <p class="mt-3 mb-0"><a href="verification-pending">Request a confirmation email</a></p>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly LoginModel _model = new();
    private bool _loading;
    private string? _error;

    private async Task LoginAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            var result = await Session.LoginAsync(_model.Email, _model.Password);
            if (result == LoginResult.Success)
            {
                Navigation.NavigateTo("/");
                return;
            }

            _error = result switch
            {
                LoginResult.Invalid => "Invalid email or password.",
                LoginResult.Unconfirmed => "Please confirm your email address before signing in.",
                _ => "Login is unavailable. Please try again."
            };
        }
        finally
        {
            _model.Password = string.Empty;
            _loading = false;
        }
    }

}
