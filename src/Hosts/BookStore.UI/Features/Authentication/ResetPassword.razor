@page "/reset-password"
@inject PasswordRecoveryClient Client
@inject AuthenticationSession Session
@inject IJSRuntime JS

<PageTitle>Reset password - BookStore</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 fw-bold mb-4">Reset password</h1>
                @if (_completed)
                {
                    <div class="alert alert-success" role="status">Your password has been reset. Sign in again with your new password.</div>
                    <a href="login" class="btn btn-primary rounded-pill px-4">Sign in</a>
                }
                else if (_linkUnavailable || _link is null)
                {
                    <div class="alert alert-danger" role="alert">
                        This reset link is invalid, expired or already used. Request a new link to continue.
                    </div>
                    <a href="forgot-password" class="btn btn-primary rounded-pill px-4">Request a new link</a>
                }
                else
                {
                    @if (_message is not null)
                    {
                        <div class="alert alert-danger" role="alert">@_message</div>
                    }
                    <EditForm Model="_model" OnValidSubmit="ResetAsync">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label for="newPassword" class="form-label">New password</label>
                            <InputText id="newPassword" type="password" class="form-control" autocomplete="new-password" @bind-Value="_model.NewPassword" />
                            <ValidationMessage For="@(() => _model.NewPassword)" />
                            <div class="form-text">Use at least 6 characters, including an uppercase letter, a lowercase letter, a number, and a symbol.</div>
                        </div>
                        <div class="mb-4">
                            <label for="confirmPassword" class="form-label">Confirm new password</label>
                            <InputText id="confirmPassword" type="password" class="form-control" autocomplete="new-password" @bind-Value="_model.ConfirmPassword" />
                            <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                        </div>
                        <button class="btn btn-primary rounded-pill px-4" type="submit" disabled="@_loading">Reset password</button>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private readonly PasswordResetModel _model = new();
    private IdentityLink? _link;
    private bool _linkUnavailable;
    private bool _loading;
    private bool _completed;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _link = await JS.InvokeAsync<IdentityLink?>("bookStorePasswordResetLink.take");
        }
        catch (JSException)
        {
            _linkUnavailable = true;
        }
    }

    private async Task ResetAsync()
    {
        if (_loading || _link is null)
        {
            return;
        }

        _loading = true;
        _message = null;
        try
        {
            var result = await Client.ResetAsync(_link, _model.NewPassword);
            if (result == PasswordResetStatus.Success)
            {
                _completed = true;
                _link = null;
                await Session.ClearLocalSessionAsync();
                return;
            }

            _message = result == PasswordResetStatus.Invalid
                ? "The reset link is invalid, expired or already used, or the password does not meet the requirements. Check the password or request a new link."
                : "Password reset is unavailable. Please try again later.";
        }
        finally
        {
            _model.NewPassword = string.Empty;
            _model.ConfirmPassword = string.Empty;
            _loading = false;
        }
    }
}
