@page "/forgot-password"
@inject PasswordRecoveryClient Client
@inject IJSRuntime JS
@inject TimeProvider Clock
@inject ILogger<ForgotPassword> Logger
@implements IDisposable

<PageTitle>Forgot password - BookStore</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 fw-bold mb-3">Forgot password</h1>
                <p>If the address is eligible, a password reset email may be sent. Please check your inbox.</p>
                @if (_message is not null)
                {
                    <div class="@(_success ? "alert alert-success" : "alert alert-danger")" role="status">@_message</div>
                }
                <EditForm Model="_model" OnValidSubmit="RequestAsync">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <InputText id="email" type="email" class="form-control" autocomplete="email" @bind-Value="_model.Email" />
                        <ValidationMessage For="@(() => _model.Email)" />
                    </div>
                    <button class="btn btn-primary rounded-pill px-4" type="submit" disabled="@(_loading || _restoring || _cooldown.RemainingSeconds > 0)">Send reset link</button>
                    @if (_cooldown.RemainingSeconds > 0)
                    {
                        <p role="status" aria-live="polite">You can request another email in @_cooldown.RemainingSeconds second@(_cooldown.RemainingSeconds == 1 ? "" : "s").</p>
                    }
                    <a href="login" class="btn btn-link">Back to login</a>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly ForgotPasswordModel _model = new();
    private const string StorageKey = "bookstore.password-recovery-until";
    private EmailRequestCooldown _cooldown = null!;
    private bool _restoring = true;
    private bool _loading;
    private bool _success;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        _cooldown = new EmailRequestCooldown(JS, Clock, StorageKey, () => InvokeAsync(StateHasChanged));
        try
        {
            await _cooldown.RestoreAsync();
        }
        catch (JSException exception)
        {
            Logger.LogStorageUnavailable(exception);
            _message = "The wait may not be shown after refreshing this page.";
        }
        finally
        {
            _restoring = false;
        }
    }

    private async Task RequestAsync()
    {
        if (_loading || _restoring || _cooldown.RemainingSeconds > 0) return;
        _loading = true;
        _message = null;
        try
        {
            var result = await Client.RequestAsync(_model.Email);
            _success = result.Status == PasswordRecoveryRequestStatus.Success;
            _message = result.Status switch
            {
                PasswordRecoveryRequestStatus.Success =>
                    "If an account matches this address, a reset email may be sent. Delivery is not guaranteed.",
                PasswordRecoveryRequestStatus.Invalid => "Please enter a valid email address.",
                PasswordRecoveryRequestStatus.RateLimited => "Too many requests. Please wait before trying again.",
                _ => "The request could not be completed. Please try again later."
            };
            if (result.RetryAfterSeconds is { } seconds)
            {
                try
                {
                    await _cooldown.StartAsync(seconds);
                }
                catch (JSException exception)
                {
                    Logger.LogStorageUnavailable(exception);
                    _message += " The wait may not be shown after refreshing this page.";
                }
            }
        }
        finally
        {
            _loading = false;
        }

    }

    public void Dispose() => _cooldown.Dispose();
}
