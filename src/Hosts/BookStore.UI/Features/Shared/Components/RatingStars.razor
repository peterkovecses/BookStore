<div class="d-flex align-items-center">
    @if (Rating is > 0)
    {
        @for (var i = 1; i <= 5; i++)
        {
            <i class="bi @GetStarClass(i) @GetStarColor(i)"></i>
        }
        @if (ReviewCount.HasValue)
        {
            <span class="ms-1 text-muted">(@ReviewCount)</span>
        }
    }
    else
    {
        <span class="text-muted small">No reviews yet</span>
    }
</div>

@code {
    [Parameter]
    public double? Rating { get; set; }

    [Parameter]
    public int? ReviewCount { get; set; }

    private string GetStarClass(int i)
    {
        if (Rating >= i) return "bi-star-fill";
        if (Rating >= i - 0.5) return "bi-star-half";
        return "bi-star";
    }

    private string GetStarColor(int i)
    {
        if (Rating >= i - 0.5) return "text-warning";
        return "text-secondary";
    }
}
