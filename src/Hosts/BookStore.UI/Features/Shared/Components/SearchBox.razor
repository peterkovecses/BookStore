@implements IDisposable

<div class="input-group @Class">
    <span class="input-group-text bg-white border-end-0">
        <i class="bi bi-search text-muted"></i>
    </span>
    <input type="text" 
           class="form-control border-start-0 ps-0" 
           placeholder="@Placeholder" 
           value="@SearchTerm" 
           @oninput="OnInput" />
    @if (!string.IsNullOrWhiteSpace(SearchTerm))
    {
        <button class="btn btn-outline-secondary border-start-0" type="button" @onclick="ClearSearch">
            <i class="bi bi-x"></i>
        </button>
    }
</div>

@code {
    private readonly Debouncer _debouncer = new();

    [Parameter]
    public string? SearchTerm { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Search...";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public int DebounceMilliseconds { get; set; } = 300;

    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    private void OnInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString();
        _debouncer.Debounce(() => InvokeAsync(() => OnSearch.InvokeAsync(SearchTerm ?? string.Empty)), DebounceMilliseconds);
    }

    private void ClearSearch()
    {
        SearchTerm = string.Empty;
        _debouncer.Cancel();
        OnSearch.InvokeAsync(string.Empty);
    }

    public void Dispose()
    {
        _debouncer.Dispose();
    }
}
