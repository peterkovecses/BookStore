@page "/books/{Id:int}"
@inherits CustomComponentBase

@if (Loading && _book is null)
{
    <div class="d-flex justify-content-center align-items-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (_book is not null)
{
    <PageTitle>@_book.Title | BookStore</PageTitle>

    <div class="container py-4">
        <div class="row g-5">
            <div class="col-md-5">
                <div class="card border-0 shadow-sm p-3 bg-light text-center" style="min-height: 400px;">
                    @if (!string.IsNullOrEmpty(_book.ImageUrl))
                    {
                        <img src="@_book.ImageUrl" class="img-fluid rounded shadow-sm mx-auto d-block" alt="@_book.Title" style="max-height: 500px;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center h-100 py-5">
                            <i class="bi bi-book text-secondary opacity-25" style="font-size: 10rem;"></i>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-7">
                <div class="mb-3">
                    @foreach (var tag in _book.Tags)
                    {
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill me-2">@tag.Id</span>
                    }
                </div>

                <h1 class="fw-bold mb-2">@_book.Title</h1>
                <p class="text-muted fs-5 mb-4">
                    by <span class="text-dark fw-semibold">@string.Join(", ", _book.Authors.Select(a => a.Name))</span>
                </p>

                <div class="d-flex align-items-center mb-4">
                    <RatingStars Rating="@_book.AverageRating" ReviewCount="@_book.Reviews.Count" />
                    <span class="ms-3 text-muted">|</span>
                    <span class="ms-3 text-muted">Published by <span class="fw-medium text-dark">@_book.Publisher</span> on @_book.PublishedOn.ToShortDateString()</span>
                </div>

                <div class="card border-0 shadow-sm bg-light p-4 mb-4">
                    <div class="d-flex align-items-end gap-3 mb-3">
                        @if (_book.Promotion is not null)
                        {
                            <h2 class="fw-bold text-danger mb-0">@_book.Promotion.NewPrice.ToCurrency()</h2>
                            <h4 class="text-muted text-decoration-line-through mb-1">@_book.Price.ToCurrency()</h4>
                            <span class="badge bg-danger rounded-pill px-3 py-2 mb-1">
                                Save @((_book.Price - _book.Promotion.NewPrice).ToCurrency())
                            </span>
                        }
                        else
                        {
                            <h2 class="fw-bold mb-0">@_book.Price.ToCurrency()</h2>
                        }
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg rounded-pill shadow-sm py-3 fw-bold">
                            <i class="bi bi-cart-plus me-2"></i>Add to Cart
                        </button>
                    </div>
                </div>

                <div class="mt-4">
                    <h5 class="fw-bold mb-3">Description</h5>
                    <p class="text-secondary lh-lg">
                        @_book.Description
                    </p>
                </div>
            </div>
        </div>

        @if (_book.Reviews.Any())
        {
            <div class="mt-5 pt-5">
                <h3 class="fw-bold mb-4">Customer Reviews</h3>
                <div class="row g-4">
                    @foreach (var review in _book.Reviews)
                    {
                        <div class="col-12">
                            <div class="card border-0 shadow-sm p-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <div class="mb-1">
                                            <RatingStars Rating="(double)review.Stars" />
                                        </div>
                                        <h6 class="fw-bold mb-0">@review.Voter</h6>
                                    </div>
                                </div>
                                <p class="text-secondary mb-0">@review.Comment</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
